generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== НОВЫЕ ENUM'Ы =====
enum Role {
  USER
  ADMIN
}

enum Gender {
  Male
  Female
}

enum Lifestyle {
  IMMOBILE
  LIGHT
  AVERAGE
  HARD
}

// Цели
enum Goal {
  LOSE_FAT           
  MAINTAIN_WEIGHT    
  GAIN_MUSCLE_MASS   
  STRENGTH           
  HYPERTROPHY        
  ENDURANCE          
  POWER              
  HEALTH             
  REHABILITATION     
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum MovementPattern {
  PUSH              // Жимы
  PULL              // Тяги
  SQUAT             // Приседания
  HINGE             // Разгибания бедра (deadlift)
  CARRY             // Переносы (farmer walk)
  CORE_STABILITY    // Стабилизация корпуса
  CORE_ROTATION     // Ротация корпуса
  CARDIO            // Кардио
  MOBILITY          // Мобильность
  ISOMETRIC         // Изометрия (планка)
}

enum TrainingFocus {
  STRENGTH          // 3-6 reps
  HYPERTROPHY       // 8-12 reps
  ENDURANCE         // 15+ reps
  POWER             // Взрывная сила
  MAINTENANCE       // Поддержание формы
  REHABILITATION    // Терапия/реабилитация
}

enum Wellbeing {
  BAD
  NORMAL
  GOOD
}

enum PrimaryMuscleGroup {
  LEGS
  BACK
  CHEST
  SHOULDERS
  ARMS
  CORE
}

enum MuscleGroup {
  NECK
  TRAPEZIUS_UPPER
  TRAPEZIUS_LOWER
  DELTOIDS_ANTERIOR
  DELTOIDS_MEDIAL
  DELTOIDS_POSTERIOR
  CHEST_UPPER
  CHEST_MIDDLE
  CHEST_LOWER
  LATS
  RHOMBOIDS_UPPER
  RHOMBOIDS_LOWER
  TERES_MAJOR
  TERES_MINOR
  ERECTOR_SPINAE_UPPER
  ERECTOR_SPINAE_LOWER
  BICEPS_LONG_HEAD
  BICEPS_SHORT_HEAD
  TRICEPS_LONG_HEAD
  TRICEPS_MEDIAL_HEAD
  TRICEPS_LATERAL_HEAD
  FOREARMS_FLEXORS
  FOREARMS_EXTENSORS
  ABS_UPPER
  ABS_LOWER
  OBLIQUES
  GLUTES_MAXIMUS
  GLUTES_MEDIAS
  ABDUCTORS
  ADDUCTORS
  QUADS_VASTUS_LATERALIS
  QUADS_VASTUS_MEDIALIS
  QUADS_RECTUS_FEMORIS
  HAMSTRINGS
  CALVES_GASTROCNEMIUS
  CALVES_SOLEUS
}

// ===== УПРАЖНЕНИЯ (обновленные) =====
model exercise {
  id                  String              @id @default(cuid())
  name                String
  description         String?
  primaryMuscleGroup  PrimaryMuscleGroup
  secondaryMuscles    MuscleGroup[]       // Анатомия
  movementPatterns    MovementPattern[]   // Множественные паттерны
  trainingFocus       TrainingFocus[]     // Цели тренировки
  difficulty          Difficulty          @default(EASY)
  imageUrl            String?
  videoUrl            String?

  favorites           favoriteExercise[]
  leastFavoriteExercises leastFavoriteExercise[]
  weeklyExercises     weeklyTrainingExercise[]
  dailyExecutions     trainingExerciseExecution[]

  @@map("exercises")
  @@index([primaryMuscleGroup])
  @@index([name(500)])
}

// ===== SPLIT'Ы (упрощенные) =====
enum TrainingSplit {
  PPL
  FULL_BODY
  UPPER_LOWER
  BRO_SPLIT
  STRENGTH_FOCUS
  HYPERTROPHY_FOCUS
}

// ===== МОДЕЛИ (остальные без изменений) =====
model user {
  id              String                  @id @default(cuid())
  login           String                  @unique
  email           String?                 @unique
  password        String
  role            Role                    @default(USER)
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  profile         userProfile?
  favoriteExercises favoriteExercise[]
  leastFavoriteExercises leastFavoriteExercise[]
  weeklyPlans     weeklyTrainingPlan[]
  dailyExecutions trainingDayExecution[]

  @@map("users")
}

model userProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  weight    Float?
  height    Float?
  gender    Gender?
  age       Int?
  lifestyle Lifestyle?
  goal      Goal?     
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_profiles")
  @@index([userId])
}

model favoriteExercise {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  createdAt  DateTime @default(now())

  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@map("favorite_exercises")
  @@index([userId])
}

model leastFavoriteExercise {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  createdAt  DateTime @default(now())

  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@map("least_favorite_exercises")
  @@index([userId])
}

// ===== НЕДЕЛЬНЫЙ ПЛАН =====
model weeklyTrainingPlan {
  id           String                   @id @default(cuid())
  userId       String
  week         Int                      
  split        TrainingSplit            
  score        Float                    
  daysPerWeek  Int
  restDays     Int[]                    
  message      String?                  
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  user         user                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises    weeklyTrainingExercise[] 

  @@unique([userId, week])
  @@map("weekly_training_plans")
  @@index([userId])
}

// УПРАЖНЕНИЯ ПЛАНА
model weeklyTrainingExercise {
  id          String        @id @default(cuid())
  planId      String
  exerciseId  String
  dayOfWeek   Int           
  sets        Int           
  repsRange   Json          
  orderInDay  Int           

  plan        weeklyTrainingPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercise    exercise               @relation(fields: [exerciseId], references: [id])

  @@unique([planId, dayOfWeek, orderInDay])
  @@map("weekly_training_exercises")
  @@index([planId, dayOfWeek])
}

// ===== ЕЖЕДНЕВНЫЕ ВЫПОЛНЕНИЯ =====
model trainingDayExecution {
  id             String                     @id @default(cuid())
  userId         String
  week           Int                        
  dayOfWeek      Int                        
  executionDate  DateTime                   
  wellbeingToday Wellbeing                  
  notes          String?                   
  createdAt      DateTime                  @default(now())

  user           user                       @relation(fields: [userId], references: [id])
  exercises      trainingExerciseExecution[]

  @@unique([userId, week, dayOfWeek, executionDate])
  @@map("training_day_executions")
  @@index([userId, executionDate])
  @@index([week, dayOfWeek])
}

model trainingExerciseExecution {
  id               String   @id @default(cuid())
  executionId      String
  exerciseId       String
  sets             Int      
  repsRange        Json     
  orderInDay       Int

  execution        trainingDayExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  exercise         exercise             @relation(fields: [exerciseId], references: [id])

  @@map("training_exercise_executions")
  @@index([executionId, orderInDay])
}
